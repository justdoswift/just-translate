{
  "name": "just-translate",
  "version": "0.2.2",
  "private": true,
  "description": "使用自己的 DeepSeek 或 OpenAI 兼容 API，以双语或只显示译文的方式翻译网页并自动补译动态内容。",
  "license": "MIT",
  "author": "Ge Peng",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justdoswift/just-translate.git"
  },
  "homepage": "https://github.com/justdoswift/just-translate#readme",
  "bugs": {
    "url": "https://github.com/justdoswift/just-translate/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:chrome": "npm run build && node --import tsx --test tests/browser/*.test.ts",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.37",
    "@types/node": "^22.19.0",
    "playwright": "^1.56.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "wxt": "0.21.4"
  }
}
